# ====================================================================
# TRANCHELAUNCH OS / OMNIGUARD PROTOCOL v2.1 CONFIGURATION
# ====================================================================

# GEMINI_API_KEY: Required for AI-powered marketing and cabal forensics
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The hosting URL for this applet
APP_URL="MY_APP_URL"

# --------------------------------------------------------------------
# 1. SOLANA MAINNET & DEVNET RPC CONFIGURATION
# --------------------------------------------------------------------
# Mainnet RPC Endpoint (Helius, QuickNode, Triton, or Solana Foundation)
SOLANA_RPC_ENDPOINT="https://api.mainnet-beta.solana.com"
SOLANA_NETWORK="mainnet-beta"

# Dedicated Helius High-Throughput RPC & Webhook URL (Optional for enterprise streaming)
HELIUS_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY"
HELIUS_WEBHOOK_SECRET="your_helius_webhook_hmac_secret"

# Jito Block Engine Private MEV Relayer (Frankfurt / NY / Amsterdam)
JITO_BLOCK_ENGINE_URL="https://frankfurt.mainnet.block-engine.jito.wtf"
JITO_AUTH_KEYPAIR="" # Base58 Private Key for Jito Auth (Optional for public bundles)

# --------------------------------------------------------------------
# 2. EVM MULTI-CHAIN RPC CONFIGURATION (BSC, Base, Ethereum)
# --------------------------------------------------------------------
# BNB Smart Chain Mainnet (Chain ID: 56)
BSC_RPC_ENDPOINT="https://bsc-dataseed.binance.org"
BSC_PRIVATE_KEY="" # Deployer Private Key for hardhat deployments

# Base Mainnet (Chain ID: 8453)
BASE_RPC_ENDPOINT="https://mainnet.base.org"
BASE_PRIVATE_KEY=""

# Ethereum Mainnet (Chain ID: 1)
ETHEREUM_RPC_ENDPOINT="https://eth.llamarpc.com"
ETHEREUM_PRIVATE_KEY=""

# Flashbots Protect & BloxRoute Private RPC Endpoints
FLASHBOTS_RPC_URL="https://rpc.flashbots.net/fast"
BLOXROUTE_BSC_URL="https://bsc.bdn.bloxroute.com"

# --------------------------------------------------------------------
# 3. TON & SUI NETWORK CONFIGURATION
# --------------------------------------------------------------------
TON_RPC_ENDPOINT="https://toncenter.com/api/v2/jsonRPC"
TON_API_KEY=""

SUI_RPC_ENDPOINT="https://fullnode.mainnet.sui.io:443"

# --------------------------------------------------------------------
# 4. ORACLE CONFIGURATION (Pyth Hermes & Chainlink)
# --------------------------------------------------------------------
PYTH_HERMES_URL="https://hermes.pyth.network"
CHAINLINK_ORACLE_UPDATE_INTERVAL_MS=3000

# --------------------------------------------------------------------
# 5. PROTOCOL KEEPER CREDENTIALS
# --------------------------------------------------------------------
KEEPER_CRANK_INTERVAL_MS=6000
KEEPER_AUTONOMOUS_CRANK_ENABLED=true
